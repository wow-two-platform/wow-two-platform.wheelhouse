// Tailnet access policy for the control-plane host and the products hosts. Paste it in the Tailscale admin console,
// Access controls. Owner devices reach the consoles, admin SSH, the canary sites and the product sites; the only tagged
// path is Wheelhouse's control host to a products host's SSH, which prod's runner deploys over.
// Save it first: a machine can carry a tag only once this policy defines it. Then tag the machines (Machines › Edit
// ACL tags), or join them with the tag (bootstrap-products.sh does, for tag:products).
{
  "tagOwners": {
    "tag:control": ["autogroup:admin"],
    "tag:canary": ["autogroup:admin"],
    "tag:products": ["autogroup:admin"],
    "tag:product-site": ["autogroup:admin"],
  },

  "grants": [
    // The owner's own devices reach each other.
    {"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},
    // Prod console on 443, dev console on 8443, administrator SSH on 22.
    {"src": ["autogroup:member"], "dst": ["tag:control"], "ip": ["tcp:443", "tcp:8443", "tcp:22"]},
    // Each canary environment answers on its own node.
    {"src": ["autogroup:member"], "dst": ["tag:canary"], "ip": ["tcp:443"]},
    // A products host: administrator SSH. Its private entry point answers through one node per product site.
    {"src": ["autogroup:member"], "dst": ["tag:products"], "ip": ["tcp:22"]},
    {"src": ["autogroup:member"], "dst": ["tag:product-site"], "ip": ["tcp:443"]},
    // Wheelhouse's control host reaches a products host's SSH, where only prod's runner key is authorized.
    {"src": ["tag:control"], "dst": ["tag:products"], "ip": ["tcp:22"]},
  ],

  // Tailscale SSH (check mode) between the owner's own devices only; the hosts use ordinary OpenSSH on 22.
  "ssh": [
    {"action": "check", "src": ["autogroup:member"], "dst": ["autogroup:self"], "users": ["autogroup:nonroot", "root"]},
  ],

  // Rejected on save if a canary, products or site node could reach the control host or each other, or if the
  // control host could reach more of a products host than its SSH.
  "tests": [
    {"src": "tag:canary", "deny": ["tag:control:443", "tag:control:8443", "tag:control:22", "tag:canary:443",
                                   "tag:products:22", "tag:product-site:443"]},
    {"src": "tag:control", "accept": ["tag:products:22"],
     "deny": ["tag:canary:443", "tag:products:443", "tag:products:5432", "tag:product-site:443"]},
    {"src": "tag:products", "deny": ["tag:control:443", "tag:control:8443", "tag:control:22", "tag:canary:443",
                                     "tag:products:22", "tag:product-site:443"]},
    {"src": "tag:product-site", "deny": ["tag:control:443", "tag:control:8443", "tag:control:22", "tag:canary:443",
                                         "tag:products:22", "tag:product-site:443"]},
  ],
}
