#!/bin/sh
# The order-time key on root, placed once before the host boots, as a provider places it: the one-time enrollment key
# the rig mounts. Then systemd starts the host.
set -eu
if [ ! -e /root/.ssh/authorized_keys ]; then
    mkdir -p /root/.ssh
    chmod 700 /root/.ssh
    cp /rig/authorized_keys /root/.ssh/authorized_keys
    chmod 600 /root/.ssh/authorized_keys
fi
exec /sbin/init
