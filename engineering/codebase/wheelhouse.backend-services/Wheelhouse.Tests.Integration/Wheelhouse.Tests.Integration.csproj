<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!--
      Integration tier — the real DB / EF model BELOW the HTTP pipeline, no web host. The actual WheelhouseDbContext over
      RelationalTestDb<WheelhouseDbContext> (schema from EnsureCreated, not the migrator), provider-switchable Postgres↔SQLite
      via TestSetupOptions (WHEELHOUSE_TEST_DB=sqlite flips the suite to in-memory SQLite). Covers enum snake_case round-trip,
      repository predicates / ordering, and unique-index constraints — what unit tests can't, and lighter than the E2E tier
      (no WebApplicationFactory). The migrator-engine suite lives in Wheelhouse.Tests.Migrations.

      The SDK Testing.Data package brings RelationalTestDb + EFCore.Sqlite / Npgsql / Respawn / Testcontainers transitively;
      Testing brings the container-fixture base. EF / Npgsql / naming-conventions also flow in via the Wheelhouse.Persistence reference.
    -->
    <ItemGroup>
        <!-- ContainerFixtureBase + PostgresFixture (Testcontainers + Respawn) + transitive Testcontainers.PostgreSql / Npgsql / Respawn. -->
        <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing"/>
        <!-- RelationalTestDb<TContext> + TestSetupOptions (the provider-switchable EF-model harness) + transitive EFCore.Sqlite/Npgsql. -->
        <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing.Data"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="EFCore.NamingConventions"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <PackageReference Include="Npgsql"/>
        <PackageReference Include="Dapper"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="AwesomeAssertions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wheelhouse.Persistence\Wheelhouse.Persistence.csproj"/>
        <ProjectReference Include="..\Wheelhouse.Domain\Wheelhouse.Domain.csproj"/>
        <!-- Observation-loop lifecycle and real runner-process cancellation below HTTP. -->
        <ProjectReference Include="..\Wheelhouse.Infrastructure\Wheelhouse.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
