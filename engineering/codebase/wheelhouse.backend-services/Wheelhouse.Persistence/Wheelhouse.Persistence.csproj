<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Bespoke SQL migrator (engine + Postgres dialect + connection factory) ships in the mono-lib SDK
         (aligned with the rest of wheelhouse's 10.0.24-beta refs). -->
    <PackageReference Include="WoW2.Sdk.Backend.Beta" />
    <!-- EF Core (Npgsql provider) stays as a pure mapper over the SQL-owned schema; snake_case naming. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

  <!-- Raw-SQL migrations embedded as Migrations/NNN-name/{Apply,Rollback}.sql; resolved by
       EmbeddedResourceMigrationSource (folderPrefix "Migrations/"). -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql">
      <LogicalName>Migrations/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wheelhouse.Application\Wheelhouse.Application.csproj" />
    <ProjectReference Include="..\Wheelhouse.Domain\Wheelhouse.Domain.csproj" />
  </ItemGroup>

  <!-- The host composition root owns all wiring (see host-configuration convention): it registers the
       internal EF stores by concrete type, so it needs visibility into them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Wheelhouse.Api" />
    <!-- The integration tier drives the real repositories over a real database. -->
    <InternalsVisibleTo Include="Wheelhouse.Tests.Integration" />
  </ItemGroup>

</Project>
