<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!--
      Migrator-engine suite (the specialized .Migrations tier): the bespoke SQL migrator's apply / idempotency / rollback
      over the embedded Migrations/NNN/*.sql, asserted against a real Postgres, and the SDK's migration lint and
      idempotency proof over the same files. NO HTTP / no web host, NO EF model.

      Rides the SDK Testing.Data harness: MigratorHarness (the apply/rollback/history driver) over the drop-schema
      MigratorPostgresFixture — always Postgres, since it asserts the real PG SQL. typeof(WheelhouseDbContext).Assembly
      (from the Wheelhouse.Persistence reference) carries the embedded migration scripts. The EF-model tier
      (Constraint / EnumRoundTrip / Store over RelationalTestDb) lives in Wheelhouse.Tests.Integration.

      Testing.Data brings the harness + Testcontainers.PostgreSql / Npgsql / Respawn transitively; the bespoke migrator
      engine (MigrationOptions in …Data.Migrations.Bespoke) comes from WoW2.Sdk.Beta.Be.
    -->
    <ItemGroup>
        <!-- MigratorHarness / MigratorPostgresFixture / MigrationHistoryRow + transitive Testcontainers.PostgreSql / Npgsql / Respawn. -->
        <PackageReference Include="WoW2.Sdk.Beta.Be.Testing.Data"/>
        <!-- The bespoke migrator engine — MigrationOptions (AllowRollback) the apply/rollback scenarios configure. -->
        <PackageReference Include="WoW2.Sdk.Beta.Be"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="AwesomeAssertions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wheelhouse.Persistence\Wheelhouse.Persistence.csproj"/>
        <ProjectReference Include="..\Wheelhouse.Domain\Wheelhouse.Domain.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
