<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!--
      E2E integration tests — boots the real Wheelhouse.Api host in-process via WebApplicationFactory<Program>
      against an ephemeral Postgres container (Testcontainers); migrate-on-boot (the bespoke SQL migrator)
      builds the schema.

      Harness now rides the SDK testing package (WoW2.Sdk.Backend.Beta.Testing): WebApiTestHost<Program>,
      PostgresFixture (Testcontainers + Respawn), and the Web JSON/envelope helpers all come from it. It
      transitively brings Microsoft.AspNetCore.Mvc.Testing, xunit, AwesomeAssertions, Testcontainers.PostgreSql,
      Respawn + Npgsql — so only the test RUNNER (which the helper package deliberately omits) is referenced here.
      Wheelhouse-specific bits that stay local: the test-admin policy rebind onto the SDK test-auth scheme
      (Testing.Auth, in the same package), WheelhouseAppFixture (DB lifecycle composing PostgresFixture) and the
      runner, vault, icon and manifest stubs.
    -->
    <ItemGroup>
        <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wheelhouse.Api\Wheelhouse.Api.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
