<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>dbd55018-bdcb-483c-89ed-a1738b7fac8f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mediator (ISender.SendAsync) + AppResult.Match — controllers dispatch + collapse the union. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wheelhouse.Application\Wheelhouse.Application.csproj" />
    <ProjectReference Include="..\Wheelhouse.Infrastructure\Wheelhouse.Infrastructure.csproj" />
    <ProjectReference Include="..\Wheelhouse.Persistence\Wheelhouse.Persistence.csproj" />
    <ProjectReference Include="..\Wheelhouse.Domain\Wheelhouse.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- wheelhouse.frontend-services (the pnpm workspace) is a sibling of wheelhouse.backend-services under engineering/codebase/. -->
    <SpaRoot>$(MSBuildProjectDirectory)\..\..\wheelhouse.frontend-services\</SpaRoot>
    <!-- The SPA builds with the Node pinned in .nvmrc when nvm has it, so an IDE launched from the Dock,
         whose PATH holds an older system Node, still builds. -->
    <SpaNodeVersion Condition="Exists('$(SpaRoot).nvmrc')">$([System.IO.File]::ReadAllText('$(SpaRoot).nvmrc').Trim())</SpaNodeVersion>
    <SpaNodeBin Condition="'$(SpaNodeVersion)' != '' and Exists('$(HOME)/.nvm/versions/node/v$(SpaNodeVersion)/bin')">$(HOME)/.nvm/versions/node/v$(SpaNodeVersion)/bin</SpaNodeBin>
    <SpaPath Condition="'$(SpaNodeBin)' != ''">$(SpaNodeBin):$(PATH)</SpaPath>
    <SpaPath Condition="'$(SpaNodeBin)' == ''">$(PATH)</SpaPath>
    <SpaEnabled Condition="'$(BuildSpa)' != 'false' and '$(SkipSpaBuild)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">true</SpaEnabled>
  </PropertyGroup>
  <!-- Reinstalls packages only when the lockfile changed since the last install. -->
  <Target Name="RestoreSpa" Condition="'$(SpaEnabled)' == 'true'"
          Inputs="$(SpaRoot)pnpm-lock.yaml" Outputs="$(SpaRoot)node_modules/.modules.yaml">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(SpaRoot)" EnvironmentVariables="PATH=$(SpaPath)" />
  </Target>
  <Target Name="BuildSpa" DependsOnTargets="RestoreSpa" BeforeTargets="PrepareForBuild;ResolveProjectStaticWebAssets"
          Condition="'$(SpaEnabled)' == 'true'">
    <Exec Command="pnpm run deploy" WorkingDirectory="$(SpaRoot)" EnvironmentVariables="PATH=$(SpaPath)" />
    <ItemGroup>
      <Content Remove="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\', '/').StartsWith('wwwroot/'))" />
      <Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
