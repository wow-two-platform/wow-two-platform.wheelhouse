<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!--
      Unit tier — pure-logic tests, zero I/O (no DB, no network, no Docker). Exercises the decision code
      directly: the FluentValidation validators, the inventory rules, icon paths and the product manifest parser,
      vault hygiene rules, the runner failure parser, and the runner and vault adapters. Adapters run against
      the SDK scripted HTTP handler and in-memory fakes in Fakes/ — deliberately NOT the e2e Harness stubs, so this
      tier stays independent of Wheelhouse.Tests.E2E.

      The SDK testing packages are here for their I/O-free helpers only (scripted HTTP, the in-memory repository);
      their Testcontainers and Mvc.Testing pieces belong to the e2e tier. Versions for the shared test packages are
      pinned to match what Wheelhouse.Tests.E2E resolves (xunit 2.9.2 / AwesomeAssertions 9.0.0 /
      TimeProvider.Testing 9.1.0).
    -->
    <ItemGroup>
        <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing"/>
        <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing.Data"/>
        <!-- The operator-token stand-in for the SDK GitHub client; pulls the core mono-lib transitively. -->
        <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing.Integrations"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="AwesomeAssertions"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wheelhouse.Application\Wheelhouse.Application.csproj"/>
        <ProjectReference Include="..\Wheelhouse.Domain\Wheelhouse.Domain.csproj"/>
        <!-- RunnerFailureParser: pure parsing of the deployment runner's failure line. -->
        <ProjectReference Include="..\Wheelhouse.Infrastructure\Wheelhouse.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
