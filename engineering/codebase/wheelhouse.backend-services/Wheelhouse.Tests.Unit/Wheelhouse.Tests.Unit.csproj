<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!--
      Unit tier — pure-logic tests, zero I/O (no DB, no network, no Docker). Exercises the decision code
      directly: the FluentValidation validators, the inventory rules, icon paths and the product manifest parser,
      vault hygiene rules, the runner failure parser, and the runner and vault adapters. Adapters run against
      scripted HttpMessageHandlers and in-memory fakes in Fakes/ — deliberately NOT the e2e Harness stubs, so this
      tier stays independent of Wheelhouse.Tests.E2E.

      No Testcontainers / Mvc.Testing / SDK.Testing here — those belong to the e2e tier. Versions for
      the shared test packages are pinned to match what Wheelhouse.Tests.E2E resolves (the SDK
      testing package brings xunit 2.9.2 / AwesomeAssertions 9.0.0 / TimeProvider.Testing 9.1.0
      transitively; we reference them explicitly since this tier omits that package).
    -->
    <ItemGroup>
        <!-- Pulls the core mono-lib transitively; its FakeGitHubClient / FakeContainerRegistryClient are not used here. -->
        <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing.Integrations"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="AwesomeAssertions"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wheelhouse.Application\Wheelhouse.Application.csproj"/>
        <ProjectReference Include="..\Wheelhouse.Domain\Wheelhouse.Domain.csproj"/>
        <!-- RunnerFailureParser: pure parsing of the deployment runner's failure line. -->
        <ProjectReference Include="..\Wheelhouse.Infrastructure\Wheelhouse.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
