{
  "name": "@wheelhouse/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Wheelhouse's Vue workspace — the product operations and deployment control plane.",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:http": "vite --mode http",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && node scripts/check-sfc.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/workspace/*.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" scripts/check-sfc.mjs *.json vite.config.ts index.html"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.103.2",
    "@wow-two-beta/ui-vue": "0.0.12",
    "lucide-vue-next": "^0.460.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.13",
    "esbuild": "^0.25.12",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
