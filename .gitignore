# ---- .NET ----
bin/
obj/
*.user
*.suo

# ---- SQLite runtime / design databases ----
*.db
*.db-shm
*.db-wal

# ---- Settings files that never reach git ----
# This machine's settings, read by an IDE run only (rehearse.py dev writes Wheelhouse's)
appsettings.Local.json
# A target's settings, mounted at deploy; and the machine file's retired name
appsettings.Target.json
appsettings.Machine.json

# ---- Node / frontend ----
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---- Built SPA copied into the API host (regenerated by `npm run deploy`) ----
engineering/codebase/wheelhouse.backend-services/Wheelhouse.Api/wwwroot/*
!engineering/codebase/wheelhouse.backend-services/Wheelhouse.Api/wwwroot/.gitkeep

# ---- IDE / OS ----
.idea/
.vs/
.vscode/
.DS_Store
__pycache__/
*.pyc
